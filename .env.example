# Groq — gratis, obtén tu key en https://console.groq.com
GROQ_API_KEY=gsk_...
# llama-3.3-70b-versatile fue dado de baja en el plan gratuito el 2026-08-16;
# openai/gpt-oss-120b es el reemplazo que recomienda Groq (también gratis).
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

# Límites de costo (defensivo aunque Groq sea gratis)
MAX_TOKENS_PER_SESSION=4000
MAX_AUDIO_MINUTES=10

# App
APP_ENV=development
LOG_LEVEL=INFO
