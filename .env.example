# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` al repo (está en .gitignore).

# --- Modelo evaluador ---
# Opción A: OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Opción B: Anthropic (alternativa)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Transcripción ---
# Opción A: OpenAI Whisper API (usa OPENAI_API_KEY arriba)
WHISPER_PROVIDER=openai
WHISPER_MODEL=whisper-1

# Opción B: Hugging Face Inference
# WHISPER_PROVIDER=huggingface
# HF_API_TOKEN=hf_...
# HF_WHISPER_MODEL=openai/whisper-large-v3-turbo

# --- Límites de costo ---
MAX_TOKENS_PER_SESSION=4000
MAX_AUDIO_MINUTES=10

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
